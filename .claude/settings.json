{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git checkout *)",
      "Bash(git branch*)",
      "Bash(git merge*)",
      "Bash(git stash*)",
      "Bash(git worktree*)",
      "Bash(git rm --cached *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git ls-files*)",
      "Bash(git check-ignore *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh issue *)",
      "Bash(gh label *)",
      "Bash(gh api *)",
      "Bash(gh repo view*)",
      "Bash(npm run *)",
      "Bash(npm ci)",
      "Bash(npm ci *)",
      "Bash(npm install *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npx *)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(tools/source.sh:*)",
      "Bash(bash tools/source.sh:*)",
      "Bash(./tools/source.sh:*)",
      "Bash(tools/screenshot.sh:*)",
      "Bash(bash tools/screenshot.sh:*)",
      "Bash(./tools/screenshot.sh:*)",
      "Bash(pkill *)",
      "Bash(pgrep *)",
      "Bash(curl *)",
      "Bash(find *)",
      "Bash(pip3 install --quiet --target *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(sed -n *)",
      "Bash(grep *)",
      "Bash(cat MEMORY.md)"
    ]
  }
}
